{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelGym",
  "mainBinaryName": "ModelGym",
  "version": "1.27.0",
  "identifier": "com.racktop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ModelGym",
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Model training and GPU server management",
    "longDescription": "ModelGym configures, queues and monitors model training on GPU servers over SSH.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "allowDowngrades": false,
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "22bdaaa4-514a-5723-ba40-e8a2c0881d81",
        "template": "windows/modelgym.wxs"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "startMenuFolder": "ModelGym",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
